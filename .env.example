# Copy to .env and fill in. Never commit .env.

# Hindsight Cloud: https://ui.hindsight.vectorize.io  (promo MEMHACK99 in billing after registering)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=northstar-interiors

# Groq: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Offline development only. Uses an in-process keyword memory and a rule-based drafter. Never demo with this.
PREQUAL_MOCK=0
